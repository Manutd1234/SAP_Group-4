# SAP AI Core client configuration - never commit real values.
AICORE_AUTH_URL=https://replace-with-auth-host/oauth/token
AICORE_CLIENT_ID=replace-me
AICORE_CLIENT_SECRET=replace-me
AICORE_RESOURCE_GROUP=default
AICORE_BASE_URL=https://replace-with-ai-api-host

# SAP HANA Cloud connection - use a secret manager in production.
HANA_ADDRESS=replace-with-hana-host
HANA_PORT=443
HANA_USER=replace-me
HANA_PASSWORD=replace-me
HANA_ENCRYPT=true
HANA_SSL_VALIDATE_CERTIFICATE=true
HANA_FEATURE_QUERY=SELECT * FROM "RISKSIGNAL_FEATURES"

# Local model-serving configuration.
MODEL_PATH=.local/model/risk_model.joblib
